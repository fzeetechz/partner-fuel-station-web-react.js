                },
                "close": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false
            },
            "mon": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false
            },
            "tue": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false
            },
            "wed": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false
            },
            "thu": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false
            },
            "fri": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false
            },
            "sat": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sun",
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat"
          ],
          "additionalProperties": false
        },
        "facilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "maxItems": 30
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Z]{3}\\d{5,15}|[a-f\\d]{24})$"
          },
          "maxItems": 20
        }
      },
      "additionalProperties": false
    },
    "query": {},
    "deviceRequired": false,
    "idempotent": false
